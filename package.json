{
  "name": "agreement-signer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && tsx scripts/gen-mcp-registry.ts && next build",
    "start": "next start",
    "start:hosted": "prisma migrate deploy && tsx scripts/bootstrap.ts && next start",
    "typecheck": "tsc --noEmit",
    "db:reset": "tsx prisma/seed.ts",
    "setup": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "test:unit": "tsx scripts/test-template.ts",
    "test:e2e": "tsx prisma/seed.ts && tsx scripts/e2e-agreements.ts && tsx scripts/gen-mcp-registry.ts --check"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@prisma/client": "^6.19.3",
    "@signpdf/placeholder-pdf-lib": "3.3.0",
    "@signpdf/signer-p12": "3.3.0",
    "@signpdf/signpdf": "3.3.0",
    "docxtemplater": "3.71.0",
    "next": "^15.5.28",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "pizzip": "3.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "unpdf": "^1.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.20.5",
    "@types/node-forge": "1.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
