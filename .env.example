# Agreement Signer: environment variables. Copy to .env for local work; set them as Railway variables when hosted.

# Postgres
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5444/agreements"

# The public address (no trailing slash). Links in emails, OAuth and MCP use it.
APP_URL="http://localhost:3000"

# 32+ random characters each. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Signing links and codes (falls back to AUTH_SECRET).
SIGN_SECRET=""
# Encrypts stored files, the Airtable token and saved signatures (AES-256-GCM). 32 bytes, base64. Required in production.
FILE_ENCRYPTION_KEY=""

# Company defaults (the Admin can change both in Settings).
COMPANY_NAME="Client Company LLC"
COMPANY_TIME_ZONE="America/New_York"

# Email through SendGrid. Delivery happens only when EMAIL_DELIVERY=on.
EMAIL_DELIVERY="off"
SENDGRID_API_KEY=""
# A SendGrid-verified sender. Until the client's domain is authenticated, Grow Rwanda's verified sender; the display
# name shown to recipients comes from Settings (the client's name).
EMAIL_FROM="info@growrwanda.com"
EMAIL_REPLY_TO=""

# .docx -> PDF. Gotenberg (a private Railway service). Locally, LibreOffice (soffice) if installed, else a draft PDF.
GOTENBERG_URL=""
GOTENBERG_USER=""
GOTENBERG_PASSWORD=""

# Files. On Railway, a volume (RAILWAY_VOLUME_MOUNT_PATH is set automatically when one is attached).
UPLOAD_DIR=""

# The first Admin, created on an empty database at boot.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""

# The daily job (POST /api/cron/daily with header x-cron-secret).
CRON_SECRET=""

# MCP connector for Grok. Redirect hosts: set to Grok's OAuth callback host(s) once confirmed.
MCP_ENABLED="true"
MCP_WRITE_TOOLS_ENABLED="true"
MCP_REDIRECT_HOSTS="grok.com,x.ai"
MCP_API_KEYS="true"

# Optional PDF digital certificate (CMP-2): a .p12, base64, and its password.
SIGNING_CERT_P12=""
SIGNING_CERT_PASSWORD=""
